# Copy to .env (git ignores it) and fill in ANCHOR_API_KEY. Every npm script
# reads this file; nothing needs exporting.

# Your Anchor API key: https://app.anchorbrowser.io/api-keys
ANCHOR_API_KEY=

# The portal. The public lab instance works, or host your own (see README).
SITE_URL=https://hangar-supply.fly.dev

# `npm run connect` adds the rest:
#   SITE_EMAIL, SITE_PASSWORD   a throwaway Hangar Supply account
#   API_TOKEN                   bearer token for GET /invoices on the Machine
#   HEAL_TOKEN                  shared token between the Machine and the Sprite

# Optional, if you send Anchor's webhooks to the Sprite (README, Notes):
# ANCHOR_WEBHOOK_SECRET=
