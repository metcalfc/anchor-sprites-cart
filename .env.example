# Hangar Supply, the portal the API reads
SITE_URL=https://<your hangar supply app>.fly.dev

# https://app.anchorbrowser.io/api-keys
ANCHOR_API_KEY=

# The Sprite's heal service (API -> Sprite), and the shared token for it
HEAL_URL=https://<your sprite url>
HEAL_TOKEN=

# Signing secret from creating the Anchor webhook (Anchor -> Sprite)
ANCHOR_WEBHOOK_SECRET=

# Optional bearer token for GET /invoices
API_TOKEN=
